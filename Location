local window = Rayfield:CreateWindow({
    name = "D0ggie Hub | Location",
    heartbeat = "https://www.sentivel.com/api/heartbeat/1e2866c9411ead3fd8fea11988d2985ac0828f5358550a6d689a774f73cc3f6d",
    SidebarLayout = true, 
    Theme = "Default",
    ToggleUIKeybind = Enum.KeyCode.K,
    ConfigurationSaving = {
        Enabled = false,
        FolderName = nil,
        FileName = "Gen2Hub"
    }
})

window:CreateSection({ name = "Location" })
local locationtab = window:CreateTab({ name = "Location", icon = 93364949241311 })

local syncing = locationtab:CreateProgress({ name = "Syncing Location", indeterminate = true })

local syncing2 = locationtab:CreateProgress({ name = "Syncing Orientation", indeterminate = true })

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

getgenv().Telemetry = {
    PositionString = "X: 0.00  Y: 0.00  Z: 0.00",
    OrientationString = "X: 0.0°  Y: 0.0°  Z: 0.0°",
    
    RawPosition = Vector3.new(0, 0, 0),
    RawOrientation = Vector3.new(0, 0, 0)
}

RunService.Heartbeat:Connect(function()
    pcall(function()
        local character = LocalPlayer.Character
        if character then
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                local currentPos = rootPart.Position
                getgenv().Telemetry.RawPosition = currentPos
                getgenv().Telemetry.PositionString = string.format(
                    "X: %.2f  Y: %.2f  Z: %.2f", 
                    currentPos.X, currentPos.Y, currentPos.Z
                )
                
                local rx, ry, rz = rootPart.CFrame:ToOrientation()
                local orientX = math.deg(rx)
                local orientY = math.deg(ry)
                local orientZ = math.deg(rz)
                
                getgenv().Telemetry.RawOrientation = Vector3.new(orientX, orientY, orientZ)
                getgenv().Telemetry.OrientationString = string.format(
                    "X: %.1f°  Y: %.1f°  Z: %.1f°", 
                    orientX, orientY, orientZ
                )
            end
        end
    end)
end)


local byUniverse, byPlace = {}, {}
for _, entry in ipairs(Games) do
	for _, id in ipairs(entry.universes) do
		byUniverse[id] = entry
	end
	for _, id in ipairs(entry.places) do
		byPlace[id] = entry
	end
end

local function notify(title, text, duration)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = duration or 6,
		})
	end)
end

local function urlEncode(str)
	return (str:gsub("[^%w%-_%.~]", function(c)
		return string.format("%%%02X", string.byte(c))
	end))
end

local function scriptUrl(entry)
	return BASE_URL .. urlEncode(FILE_PREFIX .. entry.script .. FILE_EXTENSION)
end

local entry = byPlace[game.PlaceId] or byUniverse[game.GameId]

if not entry then
	local info = string.format("PlaceId %d | GameId %d", game.PlaceId, game.GameId)
	notify("D0ggie Hub", "Game not supported yet.\n" .. info, 8)
	if setclipboard then
		pcall(setclipboard, info)
	end
	warn("[D0ggie Hub] unsupported game - " .. info)
	release()
	return
end

local url = scriptUrl(entry)
local okGet, source = pcall(function()
	return game:HttpGet(url)
end)

if not okGet or type(source) ~= "string" or #source == 0 or source:sub(1, 3) == "404" then
	notify("D0ggie Hub", entry.name .. ": script file not found on GitHub.", 8)
	warn("[D0ggie Hub] could not fetch " .. url)
	release()
	return
end

local fn, loadErr = loadstring(source)
if not fn then
	notify("D0ggie Hub", entry.name .. ": script failed to compile.", 8)
	warn("[D0ggie Hub] compile error: " .. tostring(loadErr))
	release()
	return
end

notify("D0ggie Hub", "Loading " .. entry.name .. "...", 4)

local okRun, runErr = pcall(fn)
if not okRun then
	notify("D0ggie Hub", entry.name .. ": script errored while running.", 8)
	warn("[D0ggie Hub] runtime error: " .. tostring(runErr))
end

release()
local resolved = {}

local function networkFolder()
	return ReplicatedStorage:FindFirstChild("Network")
end

local function isRemote(inst)
	return inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction")
end

local function resolve(key)
	local cached = resolved[key]
	if cached and cached.Parent then
		return cached
	end
	local net = networkFolder()
	if not net then
		return nil
	end
	local exact = net:FindFirstChild(RemoteNames[key])
	if exact and isRemote(exact) then
		resolved[key] = exact
		return exact
	end
	local best
	for _, inst in ipairs(net:GetDescendants()) do
		if isRemote(inst) then
			local lowered = string.lower(inst.Name)
			local hits = 0
			for _, word in ipairs(Patterns[key]) do
				if string.find(lowered, word, 1, true) then
					hits += 1
				end
			end
			if hits == #Patterns[key] then
				best = inst
				break
			end
		end
	end
	resolved[key] = best
	return best
end

local function call(key, ...)
	local remote = resolve(key)
	if not remote then
		return false, "remote not found"
	end
	local args = table.pack(...)
	local ok, result = pcall(function()
		if remote:IsA("RemoteFunction") then
			return remote:InvokeServer(table.unpack(args, 1, args.n))
		end
		remote:FireServer(table.unpack(args, 1, args.n))
		return true
	end)
	return ok, result
end

local function rootPart()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function humanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function breakablesFolder()
	local things = workspace:FindFirstChild("__THINGS")
	return things and things:FindFirstChild("Breakables")
end

local function eggsFolder()
	local things = workspace:FindFirstChild("__THINGS")
	return things and things:FindFirstChild("Eggs")
end

local function nearestBreakables(range, limit)
	local folder = breakablesFolder()
	local root = rootPart()
	if not folder or not root then
		return {}
	end
	local found = {}
	for _, model in ipairs(folder:GetChildren()) do
		local ok, pivot = pcall(function()
			return model:GetPivot().Position
		end)
		if ok then
			local dist = (pivot - root.Position).Magnitude
			if dist <= range then
				table.insert(found, { name = model.Name, dist = dist })
			end
		end
	end
	table.sort(found, function(a, b)
		return a.dist < b.dist
	end)
	local out = {}
	for i = 1, math.min(limit, #found) do
		out[i] = found[i].name
	end
	return out
end

local function nearestEggName()
	local folder = eggsFolder()
	local root = rootPart()
	if not folder or not root then
		return nil
	end
	local bestName, bestDist = nil, math.huge
	for _, egg in ipairs(folder:GetChildren()) do
		local ok, pivot = pcall(function()
			return egg:GetPivot().Position
		end)
		if ok then
			local dist = (pivot - root.Position).Magnitude
			if dist < bestDist then
				bestName, bestDist = egg.Name, dist
			end
		end
	end
	return bestName
end

local function currentRebirths()
	local ok, value = pcall(function()
		local save = require(ReplicatedStorage.Library.Client.Save).Get()
		return save and save.Rebirths
	end)
	if ok and tonumber(value) then
		return tonumber(value)
	end
	return nil
end

local function loop(flagName, delayKey, body)
	task.spawn(function()
		while alive do
			if Settings[flagName] then
				pcall(body)
			end
			task.wait(math.max(Settings[delayKey] or 1, 0.05))
		end
	end)
end

loop("AutoTap", "TapDelay", function()
	for _, id in ipairs(nearestBreakables(Settings.TapRange, Settings.TapsPerCycle)) do
		call("Damage", id)
	end
end)

loop("AutoHatch", "HatchDelay", function()
	local egg = Settings.EggName
	if egg == "" then
		egg = nearestEggName()
	end
	if egg then
		call("Egg", egg, Settings.HatchAmount)
	end
end)

loop("AutoRebirth", "RebirthDelay", function()
	local target = Settings.RebirthNumber
	if target <= 0 then
		local current = currentRebirths()
		target = current and (current + 1) or 1
	end
	call("Rebirth", tostring(target))
end)

loop("AutoRank", "RankDelay", function()
	local ok = call("Rank")
	for index = 1, 10 do
		call("Rank", index)
	end
	return ok
end)

loop("AutoMastery", "MasteryDelay", function()
	call("Mastery")
end)

local function doAntiAfk()
	local hum = humanoid()
	if hum then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
	local cam = workspace.CurrentCamera
	local size = cam and cam.ViewportSize or Vector2.new(800, 600)
	pcall(function()
		VirtualUser:CaptureController()
		VirtualUser:Button1Down(Vector2.new(size.X / 2, size.Y / 2), cam and cam.CFrame)
		task.wait(0.05)
		VirtualUser:Button1Up(Vector2.new(size.X / 2, size.Y / 2), cam and cam.CFrame)
	end)
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(size.X / 2, size.Y / 2, 0, true, game, 0)
		task.wait(0.05)
		VirtualInputManager:SendMouseButtonEvent(size.X / 2, size.Y / 2, 0, false, game, 0)
	end)
end

local idledConn = player.Idled:Connect(function()
	if Settings.AntiAfk then
		pcall(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.new())
		end)
	end
end)

task.spawn(function()
	local waited = 0
	while alive do
		task.wait(1)
		waited += 1
		if Settings.AntiAfk and waited >= Settings.AntiAfkInterval then
			waited = 0
			pcall(doAntiAfk)
		end
	end
end)

